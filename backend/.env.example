# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/endowed-writes?retryWrites=true&w=majority

# Long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# Frontend URL(s), comma-separated. Vercel preview URLs are allowed automatically.
CLIENT_URL=http://localhost:3000

# Public URL of this API, used to build image links (e.g. https://endowed-writes-api.onrender.com)
PUBLIC_API_URL=http://localhost:5000

# The one admin account, created automatically on first start
ADMIN_NAME=Endowed
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-strong-password

PORT=5000
NODE_ENV=development
